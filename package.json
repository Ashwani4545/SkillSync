{
  "name": "skillsync-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build && rm -rf .next && cp -R frontend/.next .next",
    "start": "npm --prefix frontend run start"
  }
}
