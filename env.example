# ─── App ─────────────────────────────────────────────────────────────
# MUST be "production" on any server. Never copy this file to a server as-is.
ENVIRONMENT=development
# Local development only: skips login. The app refuses to start in production with this true.
ALLOW_DEV_AUTH=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000   # used by the browser directly
CORS_ORIGINS=                                   # production: https://yourdomain.com
ALLOWED_HOSTS=                                  # production: api.yourdomain.com
TRUST_PROXY_HEADERS=false                       # true only behind nginx that sets X-Real-IP
IP_RATE_LIMIT=300/minute

# ─── AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=                                 # optional fallback
USE_MOCK_LLM=false                              # true = no API calls (local dev only; refused in production)
LLM_DAILY_LIMIT_USD=50
LLM_MONTHLY_LIMIT_USD=500

# ─── Auth (Clerk) ────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER=                                   # https://<your-instance>.clerk.accounts.dev  (required in production)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000  # your frontend origin(s), comma separated
ADMIN_CLERK_IDS=                                # comma separated Clerk user ids allowed to use /admin

# ─── Database / Redis ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/resumeai
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=                                 # production: required; REDIS_URL must then be redis://:<pw>@redis:6379/0
FLOWER_BASIC_AUTH=                              # production: user:strong-password

# ─── Storage (AWS S3). Prefer an IAM role in production and leave the keys empty ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=                                  # your own bucket name; no default on purpose
AWS_REGION=us-east-1

# ─── Payments (Stripe): use TEST keys locally ────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_CAREER_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...

# ─── Monitoring ──────────────────────────────────────────────────────
SENTRY_DSN=
