# ─── AI ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
USE_MOCK_LLM=false

# ─── Auth (Clerk) ────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Set these from your Clerk instance's JWT/JWKS configuration.
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
# Leave empty unless your Clerk JWT template configures an audience claim.
CLERK_AUDIENCE=
# Only enable for isolated local development. MUST remain false in staging/production.
ALLOW_DEV_AUTH=false
# Comma-separated Clerk user IDs permitted to access admin routes.
ADMIN_CLERK_IDS=

# ─── Database ────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/resumeai
REDIS_URL=redis://localhost:6379

# ─── AWS Storage ─────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=resumeai-uploads
AWS_REGION=us-east-1

# ─── Payments (Stripe) ───────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Stripe Price IDs ────────────────────────────────
STRIPE_PRO_PRICE_ID=
STRIPE_CAREER_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# ─── App ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
ENVIRONMENT=development
